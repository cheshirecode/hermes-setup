# ==============================================================================
# Hermes Agent Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env && chmod 0600 .env
#
# DO NOT commit .env to source control.
# ==============================================================================

# --- Primary LLM Provider (Recommended: OpenRouter) ---------------------------
# Default model: openrouter/google/gemini-3.7-flash (1M context, multimodal, tool calling)
OPENROUTER_API_KEY=

# --- Nous Research Portal (Optional: 1 sub for 300+ models + Tool Gateway) -----
# Get yours at https://portal.nousresearch.com
NOUS_API_KEY=

# --- Direct Providers (Optional) ----------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- Tool Gateway & Search Integrations (Optional) ----------------------------
# Web search (Firecrawl / Tavily)
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Media generation (FAL / ElevenLabs)
FAL_KEY=
ELEVENLABS_API_KEY=

# --- Messaging Gateway Platform Tokens (Optional) ----------------------------
# For unattended bots on Telegram, Discord, Slack, etc.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- Runtime & Storage Configuration -----------------------------------------
# Default is ~/.hermes
HERMES_PORT=8080
HERMES_LOG_LEVEL=INFO
