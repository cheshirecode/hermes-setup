#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Secret Scanner
# ==============================================================================
# Prevents API keys, private tokens, or credentials from being committed.

set -euo pipefail

SECRET_PATTERN='(sk-[a-zA-Z0-9_-]{20,}|ghp_[a-zA-Z0-9]{25,}|github_pat_[a-zA-Z0-9_]{30,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z-_]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----|[0-9]{9,10}:[a-zA-Z0-9_-]{35})'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

LEAK_FOUND=0
for file in $STAGED_FILES; do
  [[ -f "$file" ]] || continue
  # Ignore .env.example or tests with intentional dummy patterns
  [[ "$file" == ".env.example" ]] && continue
  
  if grep -nE "$SECRET_PATTERN" "$file" 2>/dev/null; then
    echo "ERROR: Potential secret/credential detected in '$file'!" >&2
    LEAK_FOUND=1
  fi
done

if [[ $LEAK_FOUND -ne 0 ]]; then
  echo "" >&2
  echo "Commit rejected: remove secrets or add file to .gitignore." >&2
  exit 1
fi
